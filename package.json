{
  "name": "@significa/ts-standards",
  "version": "0.0.1-development",
  "description": "Significa's shared TypeScript / JavaScript standards: Biome config and tsconfig presets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/significa/ts-standards.git"
  },
  "packageManager": "pnpm@10.34.9",
  "files": [
    "biome",
    "tsconfig"
  ],
  "exports": {
    "./biome": "./biome/biome.json",
    "./biome/astro": "./biome/astro.json",
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/react": "./tsconfig/react.json",
    "./tsconfig/astro": "./tsconfig/astro.json",
    "./tsconfig/node": "./tsconfig/node.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "biome ci .",
    "format": "biome check --write .",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.6.0 <2.7.0",
    "typescript": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
